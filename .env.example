# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=projeto_integrador
DB_AUTO_MIGRATE=true
DB_SEED=true

# Auth
JWT_SECRET=troque-este-secret-em-producao
JWT_EXPIRES_IN=8h

# CORS (lista separada por vírgula). Vazio = libera origem refletida (dev).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# Integrações
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# E-mail (recuperação de senha). Sem SMTP, o código aparece no log e em codigoDev (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MenteClara <noreply@menteclara.app>
ALLOW_DEV_RESET_CODE=true

# Frontend (usado pelo docker-compose)
EXPO_PUBLIC_API_URL=http://localhost:3000
